{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30,
      "excludeFiles": "{assets/**,api/router-lokal.php,jalankan-lokal.bat,node_modules/**,.vercel/**,vercel.json,.vercelignore,README-VERCEL.md}"
    }
  },
  "routes": [
    { "src": "/assets/(.*)\\.php", "status": 404 },
    { "src": "/(?!assets/)(.*)", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
