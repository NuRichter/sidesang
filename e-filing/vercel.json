{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30,
      "excludeFiles": "{assets/**,api/router-lokal.php,jalankan-lokal.bat,node_modules/**,.vercel/**,vercel.json,.vercelignore,README-VERCEL.md,docs/**,tools/**}"
    }
  },
  "routes": [
    { "src": "/assets/(.*)\\.php", "status": 404 },
    { "src": "/assets/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
